DATABASE_URL=postgresql://baruser:barpassword@postgres:5432/salope
SECRET_KEY=CHANGEME-generate-a-secure-random-key-at-least-32-chars
ALLOWED_EMAIL_DOMAIN=lateb.eu
CORS_ORIGINS=http://localhost:3000
FUZZY_MATCH_THRESHOLD=90

# Cookies d'auth : mettre a true en prod (HTTPS)
COOKIE_SECURE=false

# Serveur MCP (/api/mcp) : URL publique (issuer OAuth), durée des tokens,
# redirect URIs autorisées pour les clients (virgules, "*" = port loopback libre)
# PUBLIC_BASE_URL=http://localhost:3000
# MCP_ACCESS_TOKEN_EXPIRE_MINUTES=60
# MCP_REFRESH_TOKEN_EXPIRE_DAYS=30
# MCP_ALLOWED_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://vscode.dev/redirect
